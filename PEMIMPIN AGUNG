<!DOCTYPE html>
<html lang="ms" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Misi Mencari Harta Karun Pemimpin - PWA</title>
    
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#0F766E">
    <meta name="description" content="Permainan Pendidikan Islam: Misi Mencari Harta Karun Mentaati Pemimpin">
    <link rel="manifest" id="manifest-placeholder">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Fredoka & Great Vibes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Great+Vibes&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Fredoka', cursive, sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }
        
        .font-cert {
            font-family: 'Great Vibes', cursive;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #0D9488;
            border-radius: 999px;
        }

        /* Pulsing Glow Animation */
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(245, 158, 11, 0.5); }
            50% { box-shadow: 0 0 30px rgba(245, 158, 11, 0.9); }
        }
        .glow-chest {
            animation: pulseGlow 2s infinite;
        }

        /* Floating Chest Animation */
        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
            100% { transform: translateY(0px); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }

        /* Printable Sijil Styling */
        @media print {
            body * {
                visibility: hidden;
            }
            #sijil-modal, #sijil-modal * {
                visibility: visible;
            }
            #sijil-modal {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between overflow-x-hidden bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-teal-900 via-slate-900 to-amber-950">

    <!-- Header / Navbar -->
    <header class="bg-slate-950/80 backdrop-blur-md border-b border-teal-700/50 text-white px-4 py-3 sticky top-0 z-40 shadow-lg">
        <div class="max-w-6xl mx-auto flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <span class="text-3xl animate-bounce">👑</span>
                <div>
                    <h1 class="text-lg md:text-2xl font-bold tracking-wide text-amber-400">HARTA KARUN PEMIMPIN</h1>
                    <p class="text-xs text-teal-300">Pendidikan Islam: Mentaati Pemimpin</p>
                </div>
            </div>

            <!-- Dashboard Stats & Options -->
            <div class="flex items-center space-x-2 md:space-x-4 text-sm font-semibold">
                <div id="user-badge" class="hidden bg-slate-800 px-3 py-1.5 rounded-xl border border-teal-600 flex items-center space-x-2">
                    <i class="fa-solid fa-user-ninja text-amber-300"></i>
                    <span id="player-display-name" class="text-amber-200 text-xs md:text-sm font-bold">Pengembara</span>
                </div>
                <div class="bg-slate-800 px-3 py-1.5 rounded-xl border border-teal-600 flex items-center space-x-2">
                    <i class="fa-solid fa-gem text-amber-400"></i>
                    <span>Markah: <span id="score-val" class="text-amber-300 text-lg font-extrabold">0</span></span>
                </div>
                <button id="btn-sound" onclick="toggleSound()" class="p-2 bg-teal-800 hover:bg-teal-700 rounded-xl transition border border-teal-500 text-white" title="Bunyi On/Off">
                    <i id="sound-icon" class="fa-solid fa-volume-high"></i>
                </button>
                <button onclick="openTeacherDashboard()" class="p-2 bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl transition font-bold text-xs flex items-center gap-1 shadow-md" title="Papan Guru">
                    <i class="fa-solid fa-chalkboard-user"></i> <span class="hidden md:inline">Dashboard Guru</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Game Container -->
    <main class="max-w-6xl mx-auto px-3 md:px-6 py-4 flex-grow w-full flex flex-col justify-center items-center">

        <!-- Info Bar & Mission Header -->
        <div class="w-full bg-slate-950/70 rounded-2xl p-4 mb-4 border border-amber-500/40 backdrop-blur-md flex flex-wrap justify-between items-center gap-3 shadow-xl">
            <div class="flex items-center gap-3">
                <span class="bg-amber-500 text-slate-950 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider flex items-center gap-1">
                    <i class="fa-solid fa-map-location-dot"></i> Peta Harta Karun
                </span>
                <p class="text-xs md:text-sm text-teal-200">
                    Buka 12 Peti Harta Karun di Pulau Pemimpin & jawab soalan dengan betul!
                </p>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="restartGame()" class="px-4 py-2 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-xl text-xs md:text-sm transition shadow-md active:scale-95 flex items-center gap-1.5 border border-teal-400">
                    <i class="fa-solid fa-rotate-right"></i> Mula Semula
                </button>
            </div>
        </div>

        <!-- Interactive Map Grid for Treasure Chests -->
        <div class="w-full bg-gradient-to-br from-teal-950/90 via-slate-900/95 to-amber-950/80 rounded-3xl p-4 md:p-6 border-2 border-amber-500/50 shadow-2xl relative overflow-hidden">
            
            <!-- Map Decorative Header -->
            <div class="text-center mb-6">
                <h2 class="text-2xl md:text-3xl font-extrabold text-amber-400 tracking-wider flex items-center justify-center gap-2">
                    <span>🏴‍☠️</span> PULAU MENTAATI PEMIMPIN <span>📜</span>
                </h2>
                <p class="text-xs text-teal-300 mt-1">Kumpul Harta Karun Ilmu: Pilih jawapan sama ada <strong>Cara Mentaati</strong> atau <strong>Kepentingan Mentaati Pemimpin</strong></p>
            </div>

            <!-- Grid of 12 Chest Stations -->
            <div id="map-chests-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 md:gap-5">
                <!-- Chest cards will be injected dynamically -->
            </div>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-950/90 border-t border-teal-800 text-teal-400 text-center py-2.5 text-xs">
        <p>Aplikasi Pendidikan Islam PWA • Misi Mencari Harta Karun Mentaati Pemimpin • Rumi Bahasa Melayu</p>
    </footer>

    <!-- MODAL 1: BORANG ISI NAMA & KELAS (MULA-MULA) -->
    <div id="modal-login" class="fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 z-50">
        <div class="bg-slate-900 border-2 border-amber-500 rounded-3xl p-6 md:p-8 max-w-md w-full text-center shadow-2xl relative">
            <div class="text-6xl mb-3 animate-bounce">👑</div>
            <h2 class="text-2xl md:text-3xl font-bold text-amber-400 mb-1">Misi Harta Karun Pemimpin</h2>
            <p class="text-xs text-slate-300 mb-6">Sila masukkan nama dan kelas anda untuk memulakan cabaran pengembaraan pulau harta karun!</p>

            <form onsubmit="saveStudentProfile(event)" class="space-y-4 text-left">
                <div>
                    <label class="block text-xs font-bold text-teal-300 mb-1"><i class="fa-solid fa-user mr-1"></i> Nama Penuh Murid:</label>
                    <input type="text" id="input-student-name" required placeholder="Cth: Ahmad Ziyad" class="w-full bg-slate-800 border border-teal-600 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-amber-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-teal-300 mb-1"><i class="fa-solid fa-school mr-1"></i> Kelas / Sekolah:</label>
                    <input type="text" id="input-student-class" required placeholder="Cth: 5 Bijak" class="w-full bg-slate-800 border border-teal-600 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-amber-400">
                </div>

                <button type="submit" class="w-full py-3.5 mt-2 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-extrabold text-base rounded-2xl shadow-xl transition active:scale-95 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-compass text-lg"></i> Mulakan Misi Sekarang!
                </button>
            </form>
        </div>
    </div>

    <!-- MODAL 2: QUESTION / CHEST QUIZ MODAL -->
    <div id="modal-question" class="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-slate-900 border-2 border-amber-500 rounded-3xl p-6 md:p-8 max-w-lg w-full text-center shadow-2xl relative">
            <span id="question-station-num" class="bg-amber-500 text-slate-950 text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider mb-2 inline-block">
                Peti #1
            </span>
            <div class="text-5xl my-2">📦</div>
            <h3 class="text-sm font-bold text-teal-300 mb-2">Pernyataan Berkenaan Pemimpin:</h3>
            
            <div id="question-text" class="bg-slate-800 border border-teal-700/80 rounded-2xl p-4 text-base md:text-lg font-bold text-amber-200 mb-6 min-h-[80px] flex items-center justify-center shadow-inner">
                - Soalan -
            </div>

            <p class="text-xs text-slate-300 mb-4 font-semibold">Sila pilih kategori yang betul untuk membuka harta karun ini:</p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button onclick="submitAnswer('CARA')" class="p-4 bg-gradient-to-r from-teal-700 to-teal-600 hover:from-teal-600 hover:to-teal-500 text-white rounded-2xl font-bold text-sm shadow-lg border border-teal-400 transition active:scale-95 flex flex-col items-center justify-center gap-1">
                    <span class="text-xl">🤝</span>
                    <span>CARA MENTAATI</span>
                </button>
                <button onclick="submitAnswer('KEPENTINGAN')" class="p-4 bg-gradient-to-r from-amber-600 to-amber-500 hover:from-amber-500 hover:to-amber-400 text-slate-950 rounded-2xl font-extrabold text-sm shadow-lg border border-amber-300 transition active:scale-95 flex flex-col items-center justify-center gap-1">
                    <span class="text-xl">🌟</span>
                    <span>KEPENTINGAN MENTAATI</span>
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 3: RESULT / MISSION COMPLETE -->
    <div id="modal-result" class="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-slate-900 border-2 border-amber-500 rounded-3xl p-6 md:p-8 max-w-md w-full text-center shadow-2xl relative">
            <div id="modal-icon" class="text-6xl mb-2 animate-bounce">🏆</div>
            <h2 id="modal-title" class="text-2xl font-bold text-amber-400 mb-1">Tahniah! Misi Selesai</h2>
            <p id="modal-subtitle" class="text-xs text-slate-300 mb-4">Anda telah berjaya meneroka semua harta karun pemimpin!</p>

            <!-- Score Summary Card -->
            <div class="bg-slate-950/80 rounded-2xl p-4 border border-teal-700 mb-6 space-y-2 text-left">
                <div class="flex justify-between text-xs text-slate-300">
                    <span>Nama Murid:</span>
                    <span id="final-student-name" class="font-bold text-white">-</span>
                </div>
                <div class="flex justify-between text-xs text-slate-300">
                    <span>Jumlah Markah:</span>
                    <span id="final-score" class="font-bold text-amber-300 text-lg">0</span>
                </div>
                <div class="flex justify-between text-xs text-slate-300">
                    <span>Peti Dibuka:</span>
                    <span id="final-chests" class="font-bold text-teal-300">12 / 12</span>
                </div>
            </div>

            <div class="space-y-2">
                <button onclick="openCertificate()" class="w-full py-3.5 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-extrabold text-sm rounded-2xl shadow-lg transition active:scale-95 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-award text-lg"></i> Lihat & Cetak Sijil
                </button>
                <button onclick="restartGame()" class="w-full py-3 bg-slate-800 hover:bg-slate-700 text-teal-300 font-bold text-sm rounded-2xl transition active:scale-95 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-rotate-right"></i> Main Lagi
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 4: DASHBOARD AKSES GURU -->
    <div id="modal-teacher" class="fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-slate-900 border-2 border-amber-500 rounded-3xl p-5 md:p-6 max-w-3xl w-full text-slate-200 shadow-2xl relative max-h-[90vh] flex flex-col">
            <div class="flex justify-between items-center mb-4 pb-2 border-b border-slate-800">
                <div class="flex items-center gap-3">
                    <span class="text-3xl text-amber-400"><i class="fa-solid fa-chalkboard-user"></i></span>
                    <div>
                        <h3 class="text-xl font-bold text-amber-400">Dashboard Rekod Markah Murid</h3>
                        <p class="text-xs text-slate-400">Keputusan Pengembaraan Misi Harta Karun Pemimpin</p>
                    </div>
                </div>
                <button onclick="closeTeacherDashboard()" class="text-slate-400 hover:text-white text-xl p-2">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Actions Bar for Teacher -->
            <div class="flex justify-between items-center gap-2 mb-3">
                <span id="records-count" class="text-xs text-teal-300 font-bold">Jumlah Rekod: 0</span>
                <div class="flex gap-2">
                    <button onclick="exportScoresCSV()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold flex items-center gap-1 shadow">
                        <i class="fa-solid fa-file-excel"></i> Muat Turun CSV / Excel
                    </button>
                    <button onclick="clearScoresHistory()" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-bold flex items-center gap-1 shadow">
                        <i class="fa-solid fa-trash"></i> Padam Semua
                    </button>
                </div>
            </div>

            <!-- Table Body -->
            <div class="overflow-y-auto flex-grow rounded-xl border border-slate-800 bg-slate-950/60 p-2">
                <table class="w-full text-left text-xs md:text-sm">
                    <thead class="bg-slate-800 text-amber-300 uppercase tracking-wider sticky top-0">
                        <tr>
                            <th class="p-3">#</th>
                            <th class="p-3">Nama Murid</th>
                            <th class="p-3">Kelas</th>
                            <th class="p-3 text-center">Markah</th>
                            <th class="p-3 text-right">Tarikh & Masa</th>
                        </tr>
                    </thead>
                    <tbody id="teacher-scores-table" class="divide-y divide-slate-800/80">
                        <tr>
                            <td colspan="5" class="p-4 text-center text-slate-500">Tiada rekod markah disimpan.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800 flex justify-between items-center text-xs">
                <span class="text-slate-400">Rekod tersimpan secara automatik pada peranti ini</span>
                <button onclick="closeTeacherDashboard()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white rounded-xl font-bold">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 5: SIJIL PENGHARGAAN MURID -->
    <div id="modal-sijil" class="fixed inset-0 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-white text-slate-900 rounded-2xl p-6 md:p-10 max-w-2xl w-full border-8 border-amber-500 shadow-2xl relative text-center flex flex-col justify-between min-h-[520px]" id="sijil-modal">
            
            <div class="border-2 border-amber-600 p-6 rounded-lg h-full flex flex-col justify-between bg-amber-50/40">
                <div>
                    <div class="text-4xl mb-1">📜👑</div>
                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-wider text-amber-900 uppercase">Sijil Penghargaan</h1>
                    <p class="text-xs text-amber-700 font-bold uppercase tracking-widest mt-1">Misi Mencari Harta Karun Pemimpin</p>
                </div>

                <div class="my-6 space-y-3">
                    <p class="text-xs md:text-sm text-slate-600">Dengan ini diperakukan bahawa</p>
                    <h2 id="cert-student-name" class="text-2xl md:text-3xl font-bold text-teal-900 font-cert border-b-2 border-amber-400 inline-block px-8 pb-1">
                        Nama Murid
                    </h2>
                    <p class="text-xs md:text-sm text-slate-600">
                        Dari Kelas / Sekolah: <strong id="cert-student-class" class="text-slate-800">5 Cemerlang</strong>
                    </p>
                    <p class="text-xs md:text-sm text-slate-700 max-w-md mx-auto pt-2">
                        Telah berjaya menyempurnakan Misi Harta Karun serta menguasai tajuk <strong>Cara & Kepentingan Mentaati Pemimpin</strong> dengan cemerlang!
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-4 max-w-xs mx-auto my-2">
                    <div class="bg-amber-100/80 p-2.5 rounded-xl border border-amber-300">
                        <span class="block text-[10px] text-amber-800 uppercase font-bold">Jumlah Markah</span>
                        <span id="cert-score" class="text-xl font-extrabold text-amber-900">1200</span>
                    </div>
                    <div class="bg-teal-100/80 p-2.5 rounded-xl border border-teal-300">
                        <span class="block text-[10px] text-teal-800 uppercase font-bold">Pencapaian Gred</span>
                        <span id="cert-grade" class="text-sm md:text-base font-extrabold text-teal-900">MUMTAZ (CEMERLANG)</span>
                    </div>
                </div>

                <div class="flex justify-between items-end pt-6 text-xs text-slate-500 border-t border-amber-200">
                    <div class="text-left">
                        <p>Tarikh: <span id="cert-date" class="font-bold text-slate-800">23/10/2026</span></p>
                        <p class="text-[10px] text-slate-400">ID Sijil: <span id="cert-id">HKP-9821</span></p>
                    </div>
                    <div class="text-center">
                        <p class="font-bold text-slate-800">Pendidikan Islam PWA</p>
                        <p class="text-[10px]">Tajuk: Mentaati Pemimpin</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 flex gap-3 no-print">
                <button onclick="window.print()" class="flex-1 py-3 bg-teal-600 hover:bg-teal-500 text-white font-bold text-sm rounded-xl shadow transition">
                    <i class="fa-solid fa-print mr-2"></i> Cetak / Simpan PDF Sijil
                </button>
                <button onclick="closeCertificate()" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm rounded-xl">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- PWA Installation Banner -->
    <div id="pwa-install-banner" class="fixed bottom-4 left-4 right-4 md:left-auto md:right-4 md:w-96 bg-slate-900 border-2 border-amber-400 rounded-2xl p-4 shadow-2xl z-50 hidden flex items-center justify-between text-white">
        <div class="flex items-center space-x-3">
            <span class="text-3xl">👑</span>
            <div>
                <h4 class="font-bold text-sm text-amber-300">Pasang Aplikasi PWA</h4>
                <p class="text-xs text-slate-200">Main secara offline pada peranti anda!</p>
            </div>
        </div>
        <button id="btn-install-pwa" class="bg-amber-400 hover:bg-amber-300 text-slate-950 text-xs font-bold px-3 py-2 rounded-xl shadow">
            Pasang
        </button>
    </div>

    <!-- Application Script Logic -->
    <script>
        /* ==========================================================================
           DATA SET: Based on Image Content (Cara & Kepentingan Mentaati Pemimpin)
           ========================================================================== */
        const treasureData = [
            // CARA MENTAATI PEMIMPIN (6 Items)
            { id: 1, type: "CARA", text: "Patuh kepada pemimpin yang beriman dan bertaqwa." },
            { id: 2, type: "CARA", text: "Pilih pemimpin yang adil dan amanah." },
            { id: 3, type: "CARA", text: "Bekerjasama dalam melakukan kebaikan." },
            { id: 4, type: "CARA", text: "Nasihat-menasihati dengan penuh hikmah." },
            { id: 5, type: "CARA", text: "Sentiasa mendoakan kesejahteraan pemimpin." },
            { id: 6, type: "CARA", text: "Menghargai jasa dan pengorbanan pemimpin." },

            // KEPENTINGAN MENTAATI PEMIMPIN (6 Items)
            { id: 7, type: "KEPENTINGAN", text: "Mengeratkan hubungan baik antara pemimpin dengan orang bawahan." },
            { id: 8, type: "KEPENTINGAN", text: "Dapat mengembangkan syiar Islam." },
            { id: 9, type: "KEPENTINGAN", text: "Mengelakkan pergaduhan dan perselisihan faham." },
            { id: 10, type: "KEPENTINGAN", text: "Menjamin keharmonian negara." },
            { id: 11, type: "KEPENTINGAN", text: "Memantapkan keimanan kepada Allah SWT." },
            { id: 12, type: "KEPENTINGAN", text: "Disegani dan dihormati oleh negara lain." }
        ];

        /* Game State Variables */
        let studentName = "";
        let studentClass = "";
        let score = 0;
        let openedChestsCount = 0;
        let currentStation = null;
        let chestStateList = [];
        let isSoundEnabled = true;

        /* Save Student Profile */
        function saveStudentProfile(e) {
            e.preventDefault();
            studentName = document.getElementById('input-student-name').value.trim();
            studentClass = document.getElementById('input-student-class').value.trim();

            if (studentName && studentClass) {
                document.getElementById('player-display-name').innerText = `${studentName} (${studentClass})`;
                document.getElementById('user-badge').classList.remove('hidden');
                document.getElementById('modal-login').classList.add('hidden');
                initGame();
            }
        }

        /* Web Audio API Synthesizer Sound Effects */
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new AudioContext();
            }
        }

        // Sound: Applause / Cheering Synthesizer (Correct Answer)
        function playClapSound() {
            if (!isSoundEnabled) return;
            initAudio();

            // Noise applause simulation
            const bufferSize = audioCtx.sampleRate * 1.2;
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
                data[i] = Math.random() * 2 - 1;
            }

            const noise = audioCtx.createBufferSource();
            noise.buffer = buffer;

            const filter = audioCtx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.value = 1100;
            filter.Q.value = 0.6;

            const gain = audioCtx.createGain();
            gain.gain.setValueAtTime(0.01, audioCtx.currentTime);

            for (let i = 0; i < 10; i++) {
                const time = audioCtx.currentTime + (i * 0.09);
                gain.gain.setValueAtTime(0.3, time);
                gain.gain.exponentialRampToValueAtTime(0.01, time + 0.07);
            }

            noise.connect(filter);
            filter.connect(gain);
            gain.connect(audioCtx.destination);

            noise.start();
            noise.stop(audioCtx.currentTime + 1.1);

            // Triumph Arpeggio Melody
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, idx) => {
                const osc = audioCtx.createOscillator();
                const noteGain = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.value = freq;

                const startTime = audioCtx.currentTime + (idx * 0.08);
                noteGain.gain.setValueAtTime(0, startTime);
                noteGain.gain.linearRampToValueAtTime(0.25, startTime + 0.02);
                noteGain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.35);

                osc.connect(noteGain);
                noteGain.connect(audioCtx.destination);

                osc.start(startTime);
                osc.stop(startTime + 0.4);
            });
        }

        // Sound: Sad / Disappointed Synthesizer (Wrong Answer)
        function playSadSound() {
            if (!isSoundEnabled) return;
            initAudio();

            const now = audioCtx.currentTime;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();

            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(260, now);
            osc.frequency.exponentialRampToValueAtTime(95, now + 0.8);

            const lfo = audioCtx.createOscillator();
            lfo.frequency.value = 7;
            const lfoGain = audioCtx.createGain();
            lfoGain.gain.value = 12;
            lfo.connect(osc.frequency);
            lfo.start(now);
            lfo.stop(now + 0.8);

            gain.gain.setValueAtTime(0.25, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.8);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start(now);
            osc.stop(now + 0.8);
        }

        function toggleSound() {
            isSoundEnabled = !isSoundEnabled;
            const icon = document.getElementById('sound-icon');
            if (isSoundEnabled) {
                icon.className = "fa-solid fa-volume-high";
            } else {
                icon.className = "fa-solid fa-volume-xmark text-rose-400";
            }
        }

        function shuffle(array) {
            let currentIndex = array.length, randomIndex;
            while (currentIndex != 0) {
                randomIndex = Math.floor(Math.random() * currentIndex);
                currentIndex--;
                [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
            }
            return array;
        }

        /* Init Game Board */
        function initGame() {
            score = 0;
            openedChestsCount = 0;
            updateScoreUI();

            chestStateList = shuffle([...treasureData]).map((item, index) => ({
                stationNum: index + 1,
                data: item,
                isOpened: false
            }));

            renderMapGrid();
            document.getElementById('modal-result').classList.add('hidden');
        }

        function renderMapGrid() {
            const gridContainer = document.getElementById('map-chests-grid');
            gridContainer.innerHTML = '';

            chestStateList.forEach(chest => {
                const chestCard = document.createElement('div');
                
                if (chest.isOpened) {
                    chestCard.className = 'bg-slate-800/90 border-2 border-teal-500 rounded-2xl p-4 flex flex-col items-center justify-between text-center shadow-md relative opacity-85';
                    chestCard.innerHTML = `
                        <span class="bg-teal-800 text-teal-200 text-[10px] font-bold px-2 py-0.5 rounded-full mb-1">
                            Peti #${chest.stationNum}
                        </span>
                        <div class="text-4xl my-2">💎</div>
                        <span class="text-xs font-bold text-amber-300 bg-slate-950/80 px-2 py-1 rounded-lg w-full truncate border border-teal-700">
                            ${chest.data.type === 'CARA' ? 'Cara Mentaati' : 'Kepentingan'}
                        </span>
                    `;
                } else {
                    chestCard.className = 'bg-gradient-to-b from-amber-900/80 to-slate-900 border-2 border-amber-500/70 hover:border-amber-400 rounded-2xl p-4 flex flex-col items-center justify-between text-center shadow-xl cursor-pointer hover:scale-105 transition-all glow-chest animate-float';
                    chestCard.onclick = () => openQuestionModal(chest);
                    chestCard.innerHTML = `
                        <span class="bg-amber-500 text-slate-950 text-[10px] font-extrabold px-2 py-0.5 rounded-full mb-1">
                            Peti #${chest.stationNum}
                        </span>
                        <div class="text-4xl my-2">📦</div>
                        <span class="text-xs font-bold text-amber-300 flex items-center gap-1">
                            <i class="fa-solid fa-key"></i> Buka Peti
                        </span>
                    `;
                }

                gridContainer.appendChild(chestCard);
            });
        }

        function openQuestionModal(chest) {
            currentStation = chest;
            document.getElementById('question-station-num').innerText = `Peti #${chest.stationNum}`;
            document.getElementById('question-text').innerText = chest.data.text;
            document.getElementById('modal-question').classList.remove('hidden');
        }

        function submitAnswer(selectedType) {
            if (!currentStation) return;

            document.getElementById('modal-question').classList.add('hidden');

            if (selectedType === currentStation.data.type) {
                // Correct Answer
                score += 100;
                openedChestsCount++;
                currentStation.isOpened = true;
                playClapSound();
                updateScoreUI();
                renderMapGrid();

                if (openedChestsCount === treasureData.length) {
                    setTimeout(endGame, 600);
                }
            } else {
                // Wrong Answer
                score = Math.max(0, score - 20);
                playSadSound();
                updateScoreUI();

                // Flash alert on map
                const alertBanner = document.createElement('div');
                alertBanner.className = 'fixed top-20 left-1/2 -translate-x-1/2 bg-rose-600 text-white font-bold text-sm px-6 py-2.5 rounded-2xl shadow-2xl z-50 animate-bounce border border-rose-300';
                alertBanner.innerText = 'Jawapan Kurang Tepat! Cuba lagi peti ini.';
                document.body.appendChild(alertBanner);
                setTimeout(() => alertBanner.remove(), 1800);
            }
        }

        function updateScoreUI() {
            document.getElementById('score-val').innerText = score;
        }

        function endGame() {
            document.getElementById('final-student-name').innerText = `${studentName} (${studentClass})`;
            document.getElementById('final-score').innerText = score;
            document.getElementById('final-chests').innerText = `${openedChestsCount} / ${treasureData.length}`;
            document.getElementById('modal-result').classList.remove('hidden');

            // Save record to local storage for teacher
            saveScoreToLocalStorage({
                name: studentName,
                className: studentClass,
                score: score,
                date: new Date().toLocaleString('ms-MY')
            });
        }

        function restartGame() {
            initGame();
        }

        /* Teacher Scores LocalStorage Management */
        function saveScoreToLocalStorage(record) {
            let scores = JSON.parse(localStorage.getItem('harta_karun_scores') || '[]');
            scores.push(record);
            localStorage.setItem('harta_karun_scores', JSON.stringify(scores));
        }

        function openTeacherDashboard() {
            const scores = JSON.parse(localStorage.getItem('harta_karun_scores') || '[]');
            scores.sort((a, b) => b.score - a.score);

            document.getElementById('records-count').innerText = `Jumlah Rekod: ${scores.length}`;

            const tableBody = document.getElementById('teacher-scores-table');
            if (scores.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500">Tiada rekod markah murid lagi.</td></tr>`;
            } else {
                tableBody.innerHTML = scores.map((item, idx) => `
                    <tr class="hover:bg-slate-800/50 transition">
                        <td class="p-3 font-bold text-amber-400">${idx + 1}</td>
                        <td class="p-3 font-semibold text-white">${item.name}</td>
                        <td class="p-3 text-slate-300">${item.className}</td>
                        <td class="p-3 text-center font-bold text-amber-300 text-base">${item.score}</td>
                        <td class="p-3 text-right text-slate-400 text-[11px]">${item.date}</td>
                    </tr>
                `).join('');
            }

            document.getElementById('modal-teacher').classList.remove('hidden');
        }

        function closeTeacherDashboard() {
            document.getElementById('modal-teacher').classList.add('hidden');
        }

        function clearScoresHistory() {
            if (confirm("Adakah anda pasti mahu memadam semua rekod markah murid?")) {
                localStorage.removeItem('harta_karun_scores');
                openTeacherDashboard();
            }
        }

        function exportScoresCSV() {
            const scores = JSON.parse(localStorage.getItem('harta_karun_scores') || '[]');
            if (scores.length === 0) {
                alert("Tiada rekod untuk dimuat turun.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,Bil,Nama Murid,Kelas,Markah,Tarikh\n";
            scores.forEach((row, index) => {
                csvContent += `${index + 1},"${row.name}","${row.className}",${row.score},"${row.date}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Keputusan_Harta_Karun_Pemimpin_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        /* Certificate Control */
        function openCertificate() {
            document.getElementById('cert-student-name').innerText = studentName || "Nama Murid";
            document.getElementById('cert-student-class').innerText = studentClass || "Kelas";
            document.getElementById('cert-score').innerText = score;
            document.getElementById('cert-date').innerText = new Date().toLocaleDateString('ms-MY');
            document.getElementById('cert-id').innerText = 'HKP-' + Math.floor(1000 + Math.random() * 9000);

            const certGrade = document.getElementById('cert-grade');
            if (score >= 1200) {
                certGrade.innerText = "MUMTAZ (CEMERLANG)";
            } else if (score >= 900) {
                certGrade.innerText = "JAYYID JIDDAN (SANGAT BAIK)";
            } else {
                certGrade.innerText = "JAYYID (BAIK)";
            }

            document.getElementById('modal-sijil').classList.remove('hidden');
        }

        function closeCertificate() {
            document.getElementById('modal-sijil').classList.add('hidden');
        }

        /* PWA Service Worker & Manifest Setup */
        const manifestData = {
            name: "Harta Karun Pemimpin",
            short_name: "HartaPemimpin",
            description: "Permainan PWA Misi Harta Karun Mentaati Pemimpin Pendidikan Islam",
            start_url: "./",
            display: "standalone",
            background_color: "#0F172A",
            theme_color: "#0F766E",
            icons: [
                {
                    src: "https://cdn-icons-png.flaticon.com/512/2829/2829800.png",
                    sizes: "512x512",
                    type: "image/png"
                }
            ]
        };

        const manifestBlob = new Blob([JSON.stringify(manifestData)], { type: 'application/json' });
        document.getElementById('manifest-placeholder').setAttribute('href', URL.createObjectURL(manifestBlob));

        if ('serviceWorker' in navigator) {
            const swCode = `
                const CACHE_NAME = 'harta-pemimpin-v1';
                self.addEventListener('install', (e) => {
                    e.waitUntil(
                        caches.open(CACHE_NAME).then((cache) => {
                            return cache.addAll(['./']);
                        })
                    );
                });
                self.addEventListener('fetch', (e) => {
                    e.respondWith(
                        caches.match(e.request).then((res) => res || fetch(e.request))
                    );
                });
            `;
            const swBlob = new Blob([swCode], { type: 'application/javascript' });
            const swUrl = URL.createObjectURL(swBlob);

            navigator.serviceWorker.register(swUrl).catch(err => console.log('SW Error:', err));
        }

        let deferredPrompt;
        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            document.getElementById('pwa-install-banner').classList.remove('hidden');
        });

        document.getElementById('btn-install-pwa')?.addEventListener('click', () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') {
                        document.getElementById('pwa-install-banner').classList.add('hidden');
                    }
                    deferredPrompt = null;
                });
            }
        });
    </script>
</body>
